{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "DOM"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
