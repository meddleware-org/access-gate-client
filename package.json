{
  "name": "@meddleware/access-gate-client",
  "version": "0.0.6",
  "homepage": "https://docs.meddleware.co.uk/blockchain/sui/access-gate/",
  "type": "module",
  "description": "Client for the access_gate Move package: typed reads, events, transaction builders, abort messages and deployment ids.",
  "author": "MeddleWare <dev@meddleware.co.uk>",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/access-gate-client.git"
  },
  "keywords": [
    "sui",
    "nft",
    "access-control",
    "web3",
    "move"
  ],
  "files": [
    "src",
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./deployments": {
      "types": "./dist/deployments.d.ts",
      "default": "./src/deployments.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "gen:deployments": "node scripts/gen-deployments.mjs",
    "check:deployments": "node scripts/gen-deployments.mjs --check",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint:js": "eslint .",
    "lint": "npm run lint:js"
  },
  "devDependencies": {
    "@meddleware/access-gate-sui": "0.0.5",
    "@mysten/sui": "^2.35.0",
    "@types/node": "~24.12.2",
    "eslint": "^10.11.0",
    "jiti": "^2.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "~5.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "peerDependencies": {
    "@mysten/sui": "^2.33.2"
  }
}
